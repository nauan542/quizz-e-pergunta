const perguntas = [
"O que é Fórmula 1?",
"Quem é o atual campeão mundial da Fórmula 1?",
"O que os pneus de Fórmula 1 com faixa azul indicam?",
"Quem é o maior campeão da Fórmula 1?",
"Quantos pilotos participam de uma corrida de Fórmula 1?",
"Qual é o objetivo de uma corrida de Fórmula 1?",
"O que significa a bandeira quadriculada?"
];

function gerarPergunta() {
const numeroAleatorio = Math.floor(
Math.random() * perguntas.length
);

document.getElementById("pergunta").textContent =
perguntas[numeroAleatorio];
}
